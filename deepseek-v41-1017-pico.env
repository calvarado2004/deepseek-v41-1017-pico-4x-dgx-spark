# DeepSeek-V4.1-Flash-1017 on pico-dgx-ds4 (deepseek-v41-1017-pico/README.md), read by bin/launch-rank on every rank.
PICO_RUNTIME_ROOT=/opt/spark-llm/profiles/deepseek-v41-1017-pico
PICO_SERVED_MODEL_NAME=DeepSeek-V4.1-Flash-1017-Pico
# dsfront (rank 0): plain HTTP on loopback; the TLS front on :8888 relays to it. The bearer key file
# is made by scripts/stage.sh (a random key, mode 600); dsfront refuses requests without it.
PICO_HTTP_PORT=18893
PICO_KEY_FILE=/etc/spark-llm/profiles/deepseek-v41-1017-pico.key
# --max-tokens: dsfront's default AND cap for max_tokens is 32768 (frontend/src/main.rs); a long
# one-shot (thinking + answer) needs 300K+. dsfront still clamps each request to the free context.
PICO_FRONT_ARGS="--encoding 1017 --thinking --max-tokens 1048576"
# Their served build (root README "run it") minus DSGB10_RING_DIRECT (switch only).
# PICO_OEA: the lossy, batch-aware expert re-route; empty = strictly lossless.
PICO_OEA="--setenv DSGB10_OEA=4,12,9"
PICO_ENGINE_ARGS="--max-ctx 1048576 --slots 16 --big-slots 4 --setenv DSGB10_BUDGET=1 --setenv DSGB10_DRAFT1=6 --setenv DSGB10_WIDE=64 --setenv DSGB10_WIDE_COST=24,2.2,57,1.1 --draft-head4 --draft-markov8 --setenv DSGB10_HEAD4_C1=1 --setenv DSGB10_CF_MLP=/opt/spark-llm/profiles/deepseek-v41-1017-pico/engine/cfmlp_cml.bin --setenv DSGB10_CF_ALPHA=1.0 --setenv DSGB10_CERT=1"
# Kept sessions across a planned stop (engine --keep-gib).
PICO_KEEP_GIB=4
# Vision (rank 0): images through their encoder container, video as frames in the TLS front.
PICO_VISION=1
PICO_VISION_IMAGE=vllm/vllm-openai:v0.32.0
PICO_CKPT=/srv/spark-llm/models/deepseek-v41-1017-official
