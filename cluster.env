# Your four nodes, edit before anything else. Every script sources this file.
#
# SSH names of the four Sparks in RING (rank) order: rank 0 is the head, and each rank is
# cabled to rank-1 and rank+1 (rank 3 back to rank 0). They must match fleet/ring.conf.
SPARK_HOSTS="spark-0 spark-1 spark-2 spark-3"
# The head (rank 0) as the scripts reach it over SSH.
SPARK_HEAD="spark-0"
# The account that runs the ranks on every node: it builds the engine, owns the rank files
# and is in the docker group (the image encoder); passwordless sudo for stage.sh.
SPARK_USER="spark"
SPARK_HOME="/home/spark"
# The name that clients use for :8888, and the TLS certificate and key for it on the head
# (readable by SPARK_USER). The readiness probe connects to https://SPARK_API_HOST:8888.
SPARK_API_HOST="spark-0.example.lan"
SPARK_TLS_CERT="/etc/ssl/spark/fullchain.pem"
SPARK_TLS_KEY="/etc/ssl/spark/privkey.pem"
