# pico-dgx-ds4 (fork of blaesus/dsgx10): the engine, pinned, plus patches/ on top.
PICO_REPO=https://github.com/Picom-code/pico-dgx-ds4
PICO_COMMIT=f2117916f2a4cac0f79fa41680ebd39bf5d42b51
# deepseek-ai's checkpoint, as published (MXFP4 routed experts, FP8 Engram tables).
MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash-1017
MODEL_REVISION=1bae0e1088993b9b82de08f59de5be5a34e42170
CKPT=/srv/spark-llm/models/deepseek-v41-1017-official
# The per-rank files that scripts/prep.sh makes from it (one rank file + two Engram shards a node).
DSW_DIR=/srv/spark-llm/models/deepseek-v41-1017-pico
# The image encoder's container image (torch + PIL + safetensors for GB10).
VISION_IMAGE=vllm/vllm-openai:v0.32.0
